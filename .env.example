# ── Flavest frontend ────────────────────────────────────────────────────────
# Route on-chain payments (subscribe/stake/seat) to a treasury instead of self.
NEXT_PUBLIC_FLAVEST_TREASURY=
# Deployed FlavestAttestationRegistry (Coston2) — the app reads attested verdicts from it.
NEXT_PUBLIC_FLAVEST_ATTEST_REGISTRY=

# ── FDC scripts (scripts/fdc/*) ─────────────────────────────────────────────
# A funded Coston2 account. Faucet: https://faucet.flare.network/coston2
PRIVATE_KEY=
RPC_URL=https://coston2-api.flare.network/ext/C/rpc

# FDC Web2Json verifier (attestation provider) + Data Availability layer.
# Obtain an API key from your attestation provider / the Flare testnet verifier.
WEB2JSON_VERIFIER_URL=https://fdc-verifiers-testnet.flare.network/
VERIFIER_API_KEY=
DA_LAYER_URL=https://ctn2-data-availability.flare.network/

# The public JSON your safety engine exposes, attested by FDC into a verdict.
FLAVEST_SAFETY_API=https://example.com/api/safety?token=NOVA
